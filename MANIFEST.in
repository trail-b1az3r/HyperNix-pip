include README.md
include LICENSE
include pyproject.toml
include setup.py
include setup.cfg
include MANIFEST.in
include ruff.toml
include pytest.ini

# *.json covers the T1 API's shipped model registry and routing policy
# seed data (src/hypernix/t1api/data/), which package-data installs into
# the wheel but which MANIFEST.in has to name for the sdist.
recursive-include src/hypernix *.py *.json py.typed
# hyped-pro's OpenTUI app: its sources, lockfile and tests (the tests
# because the sdist ships tests). Never its node_modules.
recursive-include src/hypernix/interfaces/hyped_pro_app *.ts *.json bun.lock
recursive-include tests *.py
# The whole examples/ tree, not just *.py: the T1 API deployment
# examples are Dockerfiles, compose files, nginx config and .env
# templates, and an example you can't actually run is not an example.
recursive-include examples *
# The whole scripts/ tree: tests/test_autofix_scripts.py runs the
# autofix scripts, and the sdist ships tests/.
recursive-include scripts *
# The installer and the service manager. tests/test_install_script.py and
# tests/test_hypernix_t1_service.py run them, and the sdist ships tests/ —
# so leaving these out makes the sdist's own test suite fail on files that
# are simply not there.
include install-t1.sh
recursive-include bin *
recursive-include .github/workflows *.yml
recursive-include wiki *.md
recursive-include assets *.png *.svg *.jpg

# Noise we never want in the sdist.
global-exclude __pycache__ *.pyc *.pyo *.swp .DS_Store
prune dist
prune build
prune .venv
prune hypernix-gguf
prune src/*.egg-info
prune src/hypernix/interfaces/hyped_pro_app/node_modules
prune src/hypernix/node_modules
prune *.egg-info
