# ---------------------------------------------------------------------------
# HyperNix T1 API — example environment
#
# Copy to `.env` next to wherever you launch the server from. Every value
# here has a safe default EXCEPT the secrets, which have no default worth
# having — see "Secrets" below.
#
#   cp examples/t1api/.env.example .env
#   python -c 'import secrets; print(secrets.token_hex(32))'   # per secret
#
# `GET /status` reports which of these are set (never their values), and
# `waiter doctor` prints anything that would block a production start.
# ---------------------------------------------------------------------------

# --- General ---------------------------------------------------------------
# development | staging | production. Setting this to "production" turns on
# configuration validation: create_app() refuses to start if anything below
# is unsafe, rather than letting it surface later as a puzzling 500.
T1_ENVIRONMENT=development

# Mount path when embedding the API under an existing app (e.g. /t1).
# Leave empty when it owns the whole host.
T1_MOUNT_PREFIX=

# Serve Swagger/ReDoc. Fine for an internal deployment; set 0 if the
# OpenAPI surface should not be reachable in production.
T1_EXPOSE_DOCS=1


# --- Secrets ---------------------------------------------------------------
# HMAC secret for the scoped tokens POST /auth/token mints. Unset means an
# ephemeral per-process secret: tokens break on restart and across workers.
# Rotating this value invalidates every outstanding scoped token at once,
# which is the intended revocation story for a stateless token.
T1_TOKEN_SECRET=

# Shared secret for server-to-server module transfer. BOTH ends of a
# deployment must hold the same value. Unset means this server neither
# pushes modules nor accepts them — which is the right default until you
# actually have a second server.
T1_DEPLOY_SECRET=


# --- Storage ---------------------------------------------------------------
# SQLite for development: one file, no setup, and the default.
T1_DB_PATH=

# PostgreSQL for production. Setting this moves EVERY store — usage,
# servers, modules, jobs, billing, audit, network policy, key assignments —
# with no other change. Needs `pip install 'hypernix[t1api-pg]'`.
# T1_DATABASE_URL=postgresql://t1:CHANGEME@localhost:5432/t1api


# --- Model registry --------------------------------------------------------
# Point this at YOUR registry data. Without it the server loads the shipped
# example file, whose entries are placeholders the spec describes as "not
# currently real" and which are therefore invisible and unroutable.
# T1_MODEL_REGISTRY_PATH=/etc/hypernix/models.json

# Make those placeholder entries visible for local testing. Never in
# production — production validation flags it.
T1_ENABLE_EXAMPLE_MODELS=0

# Plan-scoped routing cascades. Change routing by editing this file, not
# by touching the router.
# T1_ROUTING_POLICY_PATH=/etc/hypernix/routing.json

# The plan a key gets when no assignment names one.
T1_DEFAULT_PLAN=free


# --- Usage -----------------------------------------------------------------
# Rolling window for per-model quota. 86400 = 24h.
T1_USAGE_RESET_PERIOD_SECONDS=86400
T1_TOKEN_DEFAULT_TTL=3600


# --- Network policy --------------------------------------------------------
T1_NETWORK_POLICY_ENABLED=1

# The three-way access decision: may a client that is on NEITHER the
# allowlist nor the blocklist connect at all?
#   1 = open unless blocked   (a public API)
#   0 = allowlist only        (a private one)
T1_ALLOW_UNLISTED_CLIENTS=1

# Addresses permitted to set X-Forwarded-For and the X-Client-* mTLS
# headers. Empty means trust no proxy and use the peer address directly.
# Getting this wrong is how a client forges its own source address, so it
# is empty by default rather than guessing at your topology.
# T1_TRUSTED_PROXIES=10.0.0.1,10.0.0.2



# --- Trusted network (0.72.4) ----------------------------------------------
# Let a connection from the LAN or your tailnet act with no key at all.
# OFF by default, and that default is the point: a private address is not
# consent. Turn it on knowing that anything able to reach this port from
# those ranges can then read this server without a credential.
T1_TRUSTED_NETWORK=0

# Which levels count. Loopback is always included when the mode is on.
T1_TRUSTED_NETWORK_LAN=1
T1_TRUSTED_NETWORK_TAILNET=1

# A SECOND, SEPARATE opt-in: partial administrative functions (currently
# the training controls -- stop, pause, resume) for those same origins.
# Separate because they are separate decisions. Letting the phone on your
# sofa read a loss curve is not letting it end six hours of training.
# A keyless caller never receives the ADMIN scope, so nothing that gates
# on admin the ordinary way is reachable without a key.
T1_TRUSTED_NETWORK_PARTIAL_ADMIN=0

# NOTE: behind a reverse proxy on the same host, every request in the
# world arrives from 127.0.0.1 -- the most trusted level there is. Set
# T1_TRUSTED_PROXIES (above) before enabling any of this, or an
# unverifiable forwarded header collapses the origin to public and the
# keyless path is refused, which is the safe half of the failure.

# --- Rate limiting ---------------------------------------------------------
T1_RATE_LIMIT_ENABLED=1

# JSON list of rules; unset uses the built-in defaults (120/min per key,
# 240/min per IP, plus a tighter bucket on the expensive endpoints).
# "Unset" never means "unlimited".
# T1_RATE_LIMIT_RULES=[{"name":"per_key","capacity":120,"refill_per_second":2,"applies_to":["key"]}]


# --- Audit -----------------------------------------------------------------
T1_AUDIT_ENABLED=1


# --- TLS / mTLS ------------------------------------------------------------
# Direct termination: uvicorn holds the certificates.
# T1_TLS_CERTFILE=/etc/hypernix/tls/server.crt
# T1_TLS_KEYFILE=/etc/hypernix/tls/server.key

# The CA that signs *client* certificates, for mTLS.
# T1_TLS_CA_CERTS=/etc/hypernix/tls/client-ca.crt

# Require a verified client certificate.
T1_MTLS_REQUIRE_CLIENT_CERT=0

# Set when a reverse proxy terminates TLS and forwards X-Client-*.
# REQUIRES T1_TRUSTED_PROXIES — without it, anything able to reach this
# process directly could forge the header, so it fails closed.
T1_MTLS_BEHIND_PROXY=0

# Optional: only these clients, checked IN ADDITION to CA verification.
# T1_MTLS_ALLOWED_SUBJECTS=CN=deploy-01,CN=deploy-02
# T1_MTLS_ALLOWED_FINGERPRINTS=AA:BB:CC:...


# --- Remote deployment -----------------------------------------------------
T1_MAX_TRANSFER_BYTES=268435456

# Allow pushing modules to private/Tailscale/LAN addresses. Off by default
# because the safe assumption for "deploy to a remote server" is that the
# target is public; a private deployment says so deliberately.
T1_ALLOW_PRIVATE_DEPLOY_TARGETS=0

# Where uploaded module blobs live. They are stored, checksummed, and
# never executed, imported, or interpreted.
# T1_MODULE_STORAGE_DIR=/var/lib/hypernix/modules


# --- Misc ------------------------------------------------------------------
# Require ?confirm=true on DELETE /servers/{id} and DELETE /modules/{id}.
T1_REQUIRE_DESTRUCTIVE_CONFIRMATION=1

# Comma-separated allowed browser origins. NEVER "*" on an authenticated
# API — a wildcard lets any site drive it with a user's credentials.
T1_CORS_ALLOW_ORIGINS=


# ===========================================================================
# T1 v1.0.26.8.0.1
# ===========================================================================

# --- The LM Studio bridge --------------------------------------------------
# Borrow a model already loaded in LM Studio. The bridge does not load,
# unload, or download anything there — LM Studio owns its models.
T1_LMSTUDIO_ENABLED=1

# Where LM Studio is, from the *server's* point of view. It does not have
# to be reachable from your clients; that is the point of the bridge.
#   same machine   http://localhost:1234
#   another PC     http://192.168.1.50:1234   (tick "Serve on Local Network")
#   over Tailscale http://desktop.tailnet-name.ts.net:1234
#
# T1_ENVIRONMENT=production refuses to start with a plaintext http:// URL
# pointing anywhere that is not loopback or Tailscale: prompts would cross
# the network in the clear. Tailscale is exempt — WireGuard already
# encrypted it.
# T1_LMSTUDIO_URL=http://localhost:1234

# Only needed if a reverse proxy in front of LM Studio wants a bearer
# token. LM Studio itself ignores it. Reported by GET /status as set or
# unset, never by value.
# T1_LMSTUDIO_API_KEY=

# Let an admin sweep loopback and the tailnet looking for LM Studio
# servers (GET /bridge/lmstudio/status?discover=true). Off by default: a
# port sweep any authenticated caller can trigger is a scanning
# primitive, and the answer only interests whoever runs the machine.
T1_LMSTUDIO_DISCOVERY=0

# Read timeout for a completion. Generous on purpose — a 70B model on a
# busy GPU can legitimately take a minute to produce its first token.
T1_LMSTUDIO_TIMEOUT=300


# --- HyperLink (the phone-facing surface) ----------------------------------
# Pairing, chat sessions, attachments, Hugging Face resolution. Backend
# for the iOS app in ios/. On by default: it adds no unauthenticated
# surface beyond POST /hyperlink/pair/redeem, which needs a code an
# admin minted by hand.
T1_HYPERLINK_ENABLED=1

# An explicit public address — a reverse proxy, a Cloudflare tunnel.
# Ranked first in GET /hyperlink/endpoints, ahead of anything probed:
# an operator who has told us the address knows better than a probe.
# T1_HYPERLINK_PUBLIC_URL=https://t1.example.com

# The port advertised to clients. Set this to whatever uvicorn is
# actually bound to — it is what the app will try to connect to, and it
# cannot be inferred from inside the process when there is a proxy in
# front.
T1_HYPERLINK_PORT=8000

# Where attachment blobs live. Content-addressed by SHA-256, two levels
# of directory fan-out.
# T1_HYPERLINK_FILES_DIR=/var/lib/hypernix/hyperlink/files

# Upload limit, in bytes. Enforced against the bytes actually read, not
# Content-Length — that header is client-supplied, and a limit checked
# against a number the client chose is not a limit. Default 64 MiB.
T1_HYPERLINK_MAX_UPLOAD_BYTES=67108864

# How long a pairing code stays valid, in seconds. Ten minutes is enough
# to walk to another room; a code is also single-use and capped at five
# failed attempts, which is what lets it be short enough to type.
T1_HYPERLINK_PAIRING_TTL=600


# --- Hugging Face ----------------------------------------------------------
# Used to resolve gated repositories (POST /hyperlink/models/resolve).
# Falls back to HF_TOKEN if this is unset. Reported by GET /status as set
# or unset, never by value.
# T1_HF_TOKEN=
