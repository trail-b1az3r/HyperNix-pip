# Python bytecode. Generated on every run, specific to the interpreter
# that wrote it, and never useful to another checkout.
#
# The 348 .pyc files that ed11d4b and ec509fe had committed are now
# untracked. A gitignore entry alone would not have done that — it only
# stops new ones being added — so they were removed from the index
# deliberately.
__pycache__/
*.py[cod]
*$py.class

# Build and packaging output
build/
dist/
*.egg-info/
.eggs/

# Node, for docs/. Not previously listed, which meant that building the
# site once left 200MB of untracked files staged by the next `git add -A`.
node_modules/
.vite/

# Test and tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/

# Local virtualenvs
.venv/
venv/

# The iOS inference engine: cloned and built by
# ios/scripts/build_llama_xcframework.sh. Hundreds of megabytes, and
# reproducible from the pinned ref — ios/vendor/llama-api-b10883.json
# records what the API looked like, which is the part worth committing.
ios/.build/
ios/vendor/llama.xcframework/
ios/vendor/llama.xcframework.json
